# Telegram Bot Token from @BotFather (required)
BOT_TOKEN=

# Public URL for serving downloaded files (required)
# Example: https://your-domain.com or http://your-server-ip:8000
BASE_DOWNLOAD_LINK=

# Comma-separated Telegram user IDs allowed to use the bot (leave empty for everyone)
WHITELIST_USERS=

# Comma-separated admin user IDs (for cookie uploads)
ADMIN_USERS=

# Days to keep downloaded files before auto-deletion
STORAGE_DAYS=2

# Hours to keep cookies (0 = until restart)
COOKIE_TTL_HOURS=0

# Max file size for Telegram upload (MB)
MAX_TELEGRAM_FILE_SIZE=50

# Enable Cloudflare Warp proxy for yt-dlp (true/false)
USE_WARP=false

# Minimum free disk space in MB before blocking downloads (0 = disabled)
MIN_DISK_FREE_MB=1024

# Enable AAC transcode for TV compatibility (true/false)
AAC_TRANSCODE=true

# Max YouTube comments to show (0-20)
MAX_COMMENTS=0

# Bot log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
